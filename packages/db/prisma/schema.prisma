// AWAAZ Database Schema — PostgreSQL + PostGIS
// Phase 3 additions: Constituency, AuthorityAssignment, GeoBoundaryVersion

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis(schema: "public")]
}

// ---------------------------------------------------------------------------
// Auth
// ---------------------------------------------------------------------------

enum UserRole {
  CITIZEN
  MLA
  ADMIN
}

model User {
  id              String   @id @default(cuid())
  name            String?
  phoneNumber     String   @unique
  role            UserRole @default(CITIZEN)
  isVerified      Boolean  @default(false)
  reputationScore Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  refreshTokens          RefreshToken[]
  citizenComplaints      Complaint[]              @relation("CitizenComplaints")
  assignedComplaints     Complaint[]              @relation("AssignedComplaints")
  statusChanges          ComplaintStatusHistory[]
  // Geo (Phase 3)
  authorityAssignments   AuthorityAssignment[]    @relation("AuthorityAssignments")
  assignedByAssignments  AuthorityAssignment[]    @relation("AssignedByUser")
  importedBoundaries     GeoBoundaryVersion[]

  @@index([role])
  @@map("users")
}

model OTPVerification {
  id          String   @id @default(cuid())
  phoneNumber String
  otpHash     String
  expiresAt   DateTime
  attempts    Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([phoneNumber, createdAt])
  @@map("otp_verifications")
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------------------
// Complaints (Phase 2)
// ---------------------------------------------------------------------------

enum ComplaintStatus {
  SUBMITTED
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  VERIFIED
  REJECTED
}

enum ComplaintPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum MediaType {
  IMAGE
  VIDEO
}

enum MediaUploadStatus {
  PENDING
  READY
  FAILED
}

model ComplaintCategory {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  icon      String?
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  complaints Complaint[]

  @@map("complaint_categories")
}

model Complaint {
  id                  String             @id @default(cuid())
  title               String
  description         String
  categoryId          String
  citizenId           String
  assignedAuthorityId String?
  status              ComplaintStatus    @default(SUBMITTED)
  priority            ComplaintPriority  @default(MEDIUM)
  latitude            Decimal            @db.Decimal(10, 7)
  longitude           Decimal            @db.Decimal(10, 7)
  address             String?
  // Geo assignment (Phase 3)
  constituencyId      String?
  assignmentSource    AssignmentSource?
  assignedAt          DateTime?
  isPublic            Boolean            @default(true)
  deletedAt           DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  category          ComplaintCategory        @relation(fields: [categoryId], references: [id])
  citizen           User                     @relation("CitizenComplaints", fields: [citizenId], references: [id])
  assignedAuthority User?                    @relation("AssignedComplaints", fields: [assignedAuthorityId], references: [id])
  constituency      Constituency?            @relation(fields: [constituencyId], references: [id])
  media             ComplaintMedia[]
  statusHistory     ComplaintStatusHistory[]

  @@index([citizenId])
  @@index([assignedAuthorityId])
  @@index([status])
  @@index([categoryId])
  @@index([constituencyId])
  @@index([assignmentSource])
  @@index([createdAt])
  @@index([isPublic, status])
  @@map("complaints")
}

model ComplaintMedia {
  id           String            @id @default(cuid())
  complaintId  String
  mediaType    MediaType
  mediaUrl     String
  mimeType     String?
  fileSize     Int?
  width        Int?
  height       Int?
  durationSec  Int?
  uploadStatus MediaUploadStatus @default(PENDING)
  externalId   String?
  sortOrder    Int               @default(0)
  createdAt    DateTime          @default(now())

  complaint Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)

  @@index([complaintId])
  @@map("complaint_media")
}

model ComplaintStatusHistory {
  id             String           @id @default(cuid())
  complaintId    String
  previousStatus ComplaintStatus?
  newStatus      ComplaintStatus
  changedById    String
  remarks        String?
  createdAt      DateTime         @default(now())

  complaint Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  changedBy User      @relation(fields: [changedById], references: [id])

  @@index([complaintId, createdAt])
  @@map("complaint_status_history")
}

// ---------------------------------------------------------------------------
// Geo Mapping & Authority Assignment (Phase 3)
// ---------------------------------------------------------------------------

/// How the complaint was assigned to a constituency/authority.
/// AUTO     — system point-in-polygon lookup
/// MANUAL   — admin override
/// UNMATCHED — no polygon contained the complaint's coordinates
enum AssignmentSource {
  AUTO
  MANUAL
  UNMATCHED
}

/// Geographic level of a constituency.
enum ConstituencyType {
  WARD
  ASSEMBLY
  PARLIAMENTARY
}

/// Tracks each batch of boundary data imported.
/// When the Election Commission redraws boundaries (delimitation), a new
/// version is created — existing complaint FKs are preserved unchanged.
model GeoBoundaryVersion {
  id           String   @id @default(cuid())
  version      String   @unique
  description  String?
  isActive     Boolean  @default(false)
  importedById String
  importedAt   DateTime @default(now())

  importedBy     User           @relation(fields: [importedById], references: [id])
  constituencies Constituency[]

  @@map("geo_boundary_versions")
}

/// One geographic unit — ward, assembly seat, or parliamentary seat.
/// The `boundary` column is a PostGIS geometry(MultiPolygon, 4326) column.
/// Prisma models it as Unsupported; all spatial writes/reads use $queryRaw.
/// `geoJson` is stored alongside for fast API serialisation without a
/// PostGIS round-trip.
model Constituency {
  id                String           @id @default(cuid())
  name              String
  code              String           @unique
  type              ConstituencyType
  geoJson           Json
  /// PostGIS geometry — written via ST_GeomFromGeoJSON, read via ST_AsGeoJSON
  boundary          Unsupported("geometry(MultiPolygon, 4326)")?
  boundaryVersionId String
  isActive          Boolean          @default(true)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  boundaryVersion     GeoBoundaryVersion    @relation(fields: [boundaryVersionId], references: [id])
  authorityAssignments AuthorityAssignment[]
  complaints          Complaint[]

  @@index([isActive])
  @@index([type, isActive])
  @@map("constituencies")
}

/// Time-bound assignment of an MLA/authority to a constituency.
/// When an MLA changes, endDate is set on the old record and a new record
/// is inserted — preserving the full assignment history.
/// `isActive` is a denormalised Boolean for fast indexed lookups;
/// it must always equal (endDate IS NULL) and is maintained by the service.
model AuthorityAssignment {
  id             String    @id @default(cuid())
  constituencyId String
  authorityId    String
  assignedById   String
  startDate      DateTime
  endDate        DateTime?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  constituency Constituency @relation(fields: [constituencyId], references: [id])
  authority    User         @relation("AuthorityAssignments", fields: [authorityId], references: [id])
  assignedBy   User         @relation("AssignedByUser", fields: [assignedById], references: [id])

  @@index([constituencyId, isActive])
  @@index([authorityId, isActive])
  @@index([startDate, endDate])
  @@map("authority_assignments")
}
