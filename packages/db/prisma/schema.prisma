// AWAAZ Database Schema — PostgreSQL + PostGIS
// Phase 3 additions: Constituency, AuthorityAssignment, GeoBoundaryVersion
// Phase 4 additions: Notification, NotificationPreference, EventLog
// Phase 6 additions: LeaderboardSnapshot
// Phase 7 additions: MediaAsset (replaces ComplaintMedia)

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis(schema: "public")]
}

// ---------------------------------------------------------------------------
// Auth
// ---------------------------------------------------------------------------

enum UserRole {
  CITIZEN
  MLA
  ADMIN
}

model User {
  id              String   @id @default(cuid())
  name            String?
  phoneNumber     String   @unique
  role            UserRole @default(CITIZEN)
  isVerified      Boolean  @default(false)
  reputationScore Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  refreshTokens          RefreshToken[]
  citizenComplaints      Complaint[]              @relation("CitizenComplaints")
  assignedComplaints     Complaint[]              @relation("AssignedComplaints")
  statusChanges          ComplaintStatusHistory[]
  // Geo (Phase 3)
  authorityAssignments   AuthorityAssignment[]    @relation("AuthorityAssignments")
  assignedByAssignments  AuthorityAssignment[]    @relation("AssignedByUser")
  importedBoundaries     GeoBoundaryVersion[]
  // Notifications (Phase 4)
  notifications          Notification[]
  notificationPreference NotificationPreference?
  // Media (Phase 7)
  uploadedMedia          MediaAsset[]           @relation("UploadedMedia")
  moderatedMedia         MediaAsset[]           @relation("ModeratedMedia")
  deletedMedia           MediaAsset[]           @relation("DeletedMedia")

  @@index([role])
  @@map("users")
}

model OTPVerification {
  id          String   @id @default(cuid())
  phoneNumber String
  otpHash     String
  expiresAt   DateTime
  attempts    Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([phoneNumber, createdAt])
  @@map("otp_verifications")
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------------------
// Complaints (Phase 2)
// ---------------------------------------------------------------------------

enum ComplaintStatus {
  SUBMITTED
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  VERIFIED
  REJECTED
}

enum ComplaintPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum MediaType {
  IMAGE
  VIDEO
}

/// Upload lifecycle state — replaces the old MediaUploadStatus enum.
/// UPLOADING → asset record created, direct upload in progress.
/// READY     → upload confirmed, asset is accessible.
/// FAILED    → upload or processing failed; citizen may retry.
/// DELETED   → soft-deleted; record retained for evidence audit trail.
enum MediaStatus {
  UPLOADING
  READY
  FAILED
  DELETED
}

/// Content moderation state.
/// PENDING  → awaiting review (default after READY).
/// APPROVED → reviewed and cleared — visible to all authorised viewers.
/// REJECTED → removed from public view; URL blocked at provider level.
enum ModerationStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Cloud storage back-end hosting the asset.
/// Abstracted so the Cloudinary → S3 migration is a config change.
enum CloudProvider {
  CLOUDINARY
  S3
  LOCAL
}

model ComplaintCategory {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  icon      String?
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  complaints Complaint[]

  @@map("complaint_categories")
}

model Complaint {
  id                  String             @id @default(cuid())
  title               String
  description         String
  categoryId          String
  citizenId           String
  assignedAuthorityId String?
  status              ComplaintStatus    @default(SUBMITTED)
  priority            ComplaintPriority  @default(MEDIUM)
  latitude            Decimal            @db.Decimal(10, 7)
  longitude           Decimal            @db.Decimal(10, 7)
  address             String?
  // Geo assignment (Phase 3)
  constituencyId      String?
  assignmentSource    AssignmentSource?
  assignedAt          DateTime?
  isPublic            Boolean            @default(true)
  deletedAt           DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  category          ComplaintCategory        @relation(fields: [categoryId], references: [id])
  citizen           User                     @relation("CitizenComplaints", fields: [citizenId], references: [id])
  assignedAuthority User?                    @relation("AssignedComplaints", fields: [assignedAuthorityId], references: [id])
  constituency      Constituency?            @relation(fields: [constituencyId], references: [id])
  media             MediaAsset[]
  statusHistory     ComplaintStatusHistory[]

  @@index([citizenId])
  @@index([assignedAuthorityId])
  @@index([status])
  @@index([categoryId])
  @@index([constituencyId])
  @@index([assignmentSource])
  @@index([createdAt])
  @@index([isPublic, status])
  @@map("complaints")
}

/// Evidence asset attached to a civic complaint.
///
/// Immutability rules (evidence integrity):
///   • complaintId, uploadedById, mediaType, uploadedAt — NEVER updated after creation.
///   • publicId, secureUrl, sha256Hash — NEVER updated after status = READY.
///   • Deletion is ALWAYS soft (deletedAt + deletedById); no physical delete
///     while complaint is in an active state.
///
/// Upload flow:
///   1. createUploadRequest  → row inserted (UPLOADING), pendingUploadToken set.
///   2. Client uploads directly to cloud provider (server not in data path).
///   3. confirmUpload        → status → READY, token cleared, metadata populated.
///   4. ModerationJob        → moderationStatus transitions PENDING → APPROVED/REJECTED.
model MediaAsset {
  id               String   @id @default(cuid())

  /// Parent complaint — cascades delete so orphan assets are never left behind.
  complaintId      String
  /// Immutable owner — set at upload time, never changed.
  uploadedById     String

  // ── File identity ─────────────────────────────────────────────────────────
  mediaType        MediaType
  /// Original client-supplied filename — display only, not used for routing.
  originalFileName String
  /// MIME type validated against the server-side whitelist before signing.
  mimeType         String
  sizeBytes        Int
  width            Int?
  height           Int?
  /// Video duration in seconds (null for images).
  durationSec      Int?

  // ── Evidence integrity ────────────────────────────────────────────────────
  /// SHA-256 hex digest of the original file bytes.
  /// • Duplicate detection: same hash across complaints = recycled evidence.
  /// • Tamper detection: hash mismatch after retrieval indicates file mutation.
  /// • Legal audit: chain-of-custody proof for public-interest complaints.
  /// Populated by confirmUpload; null for legacy rows and failed uploads.
  sha256Hash       String?

  /// EXIF/metadata capture timestamp — when the photo/video was actually taken.
  /// Distinct from uploadedAt (when the citizen submitted it).
  /// Useful for: timeline disputes, detecting backdated evidence, governance SLAs.
  capturedAt       DateTime?

  // ── Cloud provider ────────────────────────────────────────────────────────
  cloudProvider    CloudProvider @default(CLOUDINARY)
  /// Provider-assigned asset identifier — immutable after READY.
  publicId         String        @default("")
  /// Primary HTTPS delivery URL.
  secureUrl        String        @default("")
  /// Auto-generated thumbnail (Cloudinary eager transform / S3 Lambda).
  thumbnailUrl     String?
  /// CDN-rewritten URL for future provider migration — populated post-MVP.
  cdnUrl           String?

  // ── State machine ─────────────────────────────────────────────────────────
  status           MediaStatus      @default(UPLOADING)

  // ── Moderation ────────────────────────────────────────────────────────────
  moderationStatus ModerationStatus @default(PENDING)
  moderationNotes  String?
  moderatedById    String?
  moderatedAt      DateTime?

  // ── Upload session integrity ───────────────────────────────────────────────
  /// Server-issued CUID2 nonce. Confirmed by client in confirmUpload to prove
  /// the publicId was issued by this server — prevents publicId forgery.
  /// Cleared (set NULL) after status transitions to READY.
  pendingUploadToken String? @unique

  // ── Display ───────────────────────────────────────────────────────────────
  sortOrder        Int      @default(0)

  // ── Lifecycle timestamps ──────────────────────────────────────────────────
  uploadedAt       DateTime  @default(now())
  deletedAt        DateTime?
  deletedById      String?

  complaint   Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  uploadedBy  User      @relation("UploadedMedia",   fields: [uploadedById], references: [id])
  moderatedBy User?     @relation("ModeratedMedia",  fields: [moderatedById], references: [id])
  deletedBy   User?     @relation("DeletedMedia",    fields: [deletedById],   references: [id])

  /// Fast read: all active media for a complaint (most common query)
  @@index([complaintId, status])
  /// Moderation queue: oldest pending items first
  @@index([moderationStatus, uploadedAt])
  /// Soft-delete filter: active assets for a complaint
  @@index([complaintId, deletedAt])
  /// Ownership: citizen views / analytics
  @@index([uploadedById, uploadedAt])
  /// Hash-based duplicate detection
  @@index([sha256Hash])
  @@map("media_assets")
}

model ComplaintStatusHistory {
  id             String           @id @default(cuid())
  complaintId    String
  previousStatus ComplaintStatus?
  newStatus      ComplaintStatus
  changedById    String
  remarks        String?
  createdAt      DateTime         @default(now())

  complaint Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  changedBy User      @relation(fields: [changedById], references: [id])

  @@index([complaintId, createdAt])
  @@map("complaint_status_history")
}

// ---------------------------------------------------------------------------
// Geo Mapping & Authority Assignment (Phase 3)
// ---------------------------------------------------------------------------

/// How the complaint was assigned to a constituency/authority.
/// AUTO     — system point-in-polygon lookup
/// MANUAL   — admin override
/// UNMATCHED — no polygon contained the complaint's coordinates
enum AssignmentSource {
  AUTO
  MANUAL
  UNMATCHED
}

/// Geographic level of a constituency.
enum ConstituencyType {
  WARD
  ASSEMBLY
  PARLIAMENTARY
}

/// Tracks each batch of boundary data imported.
/// When the Election Commission redraws boundaries (delimitation), a new
/// version is created — existing complaint FKs are preserved unchanged.
model GeoBoundaryVersion {
  id           String   @id @default(cuid())
  version      String   @unique
  description  String?
  isActive     Boolean  @default(false)
  importedById String
  importedAt   DateTime @default(now())

  importedBy     User           @relation(fields: [importedById], references: [id])
  constituencies Constituency[]

  @@map("geo_boundary_versions")
}

/// One geographic unit — ward, assembly seat, or parliamentary seat.
/// The `boundary` column is a PostGIS geometry(MultiPolygon, 4326) column.
/// Prisma models it as Unsupported; all spatial writes/reads use $queryRaw.
/// `geoJson` is stored alongside for fast API serialisation without a
/// PostGIS round-trip.
model Constituency {
  id                String           @id @default(cuid())
  name              String
  code              String           @unique
  type              ConstituencyType
  geoJson           Json
  /// PostGIS geometry — written via ST_GeomFromGeoJSON, read via ST_AsGeoJSON
  boundary          Unsupported("geometry(MultiPolygon, 4326)")?
  boundaryVersionId String
  isActive          Boolean          @default(true)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  boundaryVersion     GeoBoundaryVersion    @relation(fields: [boundaryVersionId], references: [id])
  authorityAssignments AuthorityAssignment[]
  complaints          Complaint[]

  @@index([isActive])
  @@index([type, isActive])
  @@map("constituencies")
}

/// Time-bound assignment of an MLA/authority to a constituency.
/// When an MLA changes, endDate is set on the old record and a new record
/// is inserted — preserving the full assignment history.
/// `isActive` is a denormalised Boolean for fast indexed lookups;
/// it must always equal (endDate IS NULL) and is maintained by the service.
model AuthorityAssignment {
  id             String    @id @default(cuid())
  constituencyId String
  authorityId    String
  assignedById   String
  startDate      DateTime
  endDate        DateTime?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  constituency Constituency @relation(fields: [constituencyId], references: [id])
  authority    User         @relation("AuthorityAssignments", fields: [authorityId], references: [id])
  assignedBy   User         @relation("AssignedByUser", fields: [assignedById], references: [id])

  @@index([constituencyId, isActive])
  @@index([authorityId, isActive])
  @@index([startDate, endDate])
  @@map("authority_assignments")
}

// ---------------------------------------------------------------------------
// Event System & Notifications (Phase 4)
// ---------------------------------------------------------------------------

/// Type of in-app notification delivered to a user.
enum NotificationType {
  COMPLAINT_CREATED
  COMPLAINT_ASSIGNED
  COMPLAINT_STATUS_UPDATED
  COMPLAINT_RESOLVED
  COMPLAINT_VERIFIED
  COMPLAINT_REJECTED
  SYSTEM_ANNOUNCEMENT
}

/// Processing status of an event in the EventLog.
/// Used by the outbox pattern (Phase 5) for guaranteed delivery.
enum EventStatus {
  PENDING
  PROCESSED
  FAILED
  DEAD
}

/// One notification per user per event.
/// Immutable once created — isRead / readAt are the only mutable fields.
model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  /// Structured context for deep-linking — e.g. { complaintId, status }
  metadata  Json             @default("{}")
  isRead    Boolean          @default(false)
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@map("notifications")
}

/// Per-user channel preferences.
/// One row per user — upserted at first login / first notification.
/// pushEnabled and emailEnabled default to false until the respective
/// token / email address is verified and registered.
model NotificationPreference {
  id           String   @id @default(cuid())
  userId       String   @unique
  inAppEnabled Boolean  @default(true)
  pushEnabled  Boolean  @default(false)
  emailEnabled Boolean  @default(false)
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

// ---------------------------------------------------------------------------
// Leaderboard Engine (Phase 6)
// ---------------------------------------------------------------------------

/// Pre-computed leaderboard score snapshot for an authority or constituency.
///
/// Snapshots are append-only — never mutated after isPublished = true.
/// scoreVersion allows formula changes without invalidating historical data.
/// isPublished is flipped atomically for an entire batch so users never see
/// a partially-generated leaderboard.
model LeaderboardSnapshot {
  id              String   @id @default(cuid())
  /// 'AUTHORITY' | 'CONSTITUENCY' — string (not enum) for future extensibility
  entityType      String
  /// userId for AUTHORITY, constituencyId for CONSTITUENCY
  entityId        String
  /// Denormalised name — avoids JOIN at read time for high-traffic endpoints
  entityName      String
  /// Final weighted score, 0.0–100.0
  score           Float
  /// 1-based dense rank within (entityType, periodType, periodStart)
  rank            Int
  /// Full score component breakdown stored as JSON for auditability
  /// Shape: { verifiedRate, approvalRate, timeScore, assignmentEff,
  ///          openPenalty, rejectedPenalty, rawMetrics: { ... } }
  metrics         Json
  /// Scoring formula version — bump when weights change
  scoreVersion    String   @default("v1")
  /// 'WEEKLY' | 'MONTHLY' | 'QUARTERLY' | 'ALL_TIME'
  periodType      String
  /// Inclusive start of the scoring window
  periodStart     DateTime
  /// Inclusive end of the scoring window
  periodEnd       DateTime
  /// Groups all snapshots created in one generation run
  generationBatch String
  /// False during generation — flipped true atomically for the whole batch
  isPublished     Boolean  @default(false)
  generatedAt     DateTime @default(now())

  /// Fast leaderboard page query: entity type + period + published, ordered by rank
  @@index([entityType, periodType, periodStart, isPublished])
  /// Entity rank history: all periods for one entity
  @@index([entityId, entityType, periodType])
  /// Batch publication: flip isPublished for all rows in one batch
  @@index([generationBatch])
  @@map("leaderboard_snapshots")
}

/// Append-only log of every domain event published by the system.
///
/// Phase 4: populated by EventPublisher as a secondary write.
///          status is set to PROCESSED after the BullMQ job completes.
///
/// Phase 5 (Outbox Pattern): EventPublisher writes PENDING rows first;
///          a separate poller reads PENDING rows and enqueues BullMQ jobs,
///          guaranteeing at-least-once delivery even if Redis is temporarily
///          unavailable.
///
/// Useful for: event replay, audit trail, debugging, analytics pipelines.
model EventLog {
  id          String      @id @default(cuid())
  eventType   String
  /// Full event payload serialised as JSON
  payload     Json
  status      EventStatus @default(PENDING)
  /// BullMQ job id — set after successful enqueue
  jobId       String?
  /// Error message from the last failed processing attempt
  errorMsg    String?
  attempts    Int         @default(0)
  processedAt DateTime?
  createdAt   DateTime    @default(now())

  @@index([eventType, status])
  @@index([status, createdAt])
  @@map("event_logs")
}
