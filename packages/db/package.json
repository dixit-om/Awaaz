{
  "name": "@awaaz/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "prisma db seed",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "build": "prisma generate && tsc"
  },
  "dependencies": {
    "@prisma/client": "^6.9.0"
  },
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@awaaz/eslint-config": "workspace:*",
    "@awaaz/typescript-config": "workspace:*",
    "@types/node": "^22.15.29",
    "eslint": "^9.28.0",
    "prisma": "^6.9.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
