# =============================================================================
# AWAAZ — Environment Variables (copy to .env at repo root)
# =============================================================================

# App
NODE_ENV=development

# API Server (tRPC)
SERVER_PORT=4000
SERVER_URL=http://localhost:4000

# Web (Next.js)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Database (PostgreSQL + PostGIS)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/awaaz?schema=public

# Redis (BullMQ / caching — future jobs)
REDIS_URL=redis://localhost:6379

# Auth (required — min 32 characters each)
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
OTP_PEPPER=change-me-otp-pepper-min-16-chars
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_SEND_COOLDOWN_SECONDS=60
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
OTP_DEV_MODE=true

# External services (placeholders)
# Required for evidence uploads (images/videos on complaints).
# Create an unsigned or signed upload preset named "awaaz_evidence" in Cloudinary dashboard.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Mapbox — optional; only needed for future interactive maps (address lookup uses OpenStreetMap, no key)
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=
# Optional server-side token (sk.*) for future Mapbox server calls
MAPBOX_ACCESS_TOKEN=
FIREBASE_PROJECT_ID=
